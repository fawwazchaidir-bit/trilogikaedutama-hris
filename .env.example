# ─────────────────────────────────────────────────────────────
# Trilogika Edutama — Mini HRIS
# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (wajib)
DATABASE_URL="postgresql://hris:CHANGE_ME@localhost:5432/trilogika_hris?schema=public"

# URL publik aplikasi. Dipakai untuk pemeriksaan Origin (CSRF) dan penentuan cookie `Secure`.
# Production wajib https://
APP_URL="http://localhost:3000"

# Zona waktu bisnis. Semua "hari ini", jam masuk/pulang, dan batas tidak hadir mengacu ke sini (waktu SERVER).
APP_TIMEZONE="Asia/Jakarta"

# Kunci enkripsi AES-256 (32 byte, base64) untuk nomor rekening karyawan. WAJIB; buat dengan:
#   openssl rand -base64 32
# Simpan terpisah dari database & backup. Kehilangan kunci = nomor rekening tidak dapat dibaca lagi.
DATA_ENCRYPTION_KEY=""

# Set "true" HANYA jika aplikasi berada di belakang reverse proxy tepercaya (Nginx/Caddy/Cloudflare)
# sehingga header X-Forwarded-For boleh dipercaya untuk rate limit login.
TRUST_PROXY="false"

# Pembatasan percobaan login (per email dan per IP)
LOGIN_MAX_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"
LOGIN_LOCKOUT_MINUTES="15"

# Masa berlaku sesi
SESSION_IDLE_HOURS="8"
SESSION_ABSOLUTE_DAYS="7"

# Batas unggahan (logo, foto, lampiran pengajuan) dalam MB
MAX_UPLOAD_MB="3"

# ── Seed produksi (`npm run db:seed`) ─────────────────────────
# Akun Super Admin pertama. Tidak ada password default: seed GAGAL bila kosong / terlalu lemah (<12 karakter).
ADMIN_EMAIL=""
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=""

# ── Seed demonstrasi (`npm run db:seed:dev`) ──────────────────
# Password untuk akun DEMO (hanya untuk pengujian). Bila kosong, dibuat acak dan dicetak sekali di terminal.
DEV_SEED_PASSWORD=""

# ── Testing ───────────────────────────────────────────────────
# Database TERPISAH untuk integration/E2E test. Tabel di dalamnya akan dikosongkan oleh test!
TEST_DATABASE_URL="postgresql://hris:CHANGE_ME@localhost:5432/trilogika_hris_test?schema=public"
