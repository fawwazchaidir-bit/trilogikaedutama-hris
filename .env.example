# ─────────────────────────────────────────────────────────────
# Trilogika Edutama — Mini HRIS
# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (wajib)
DATABASE_URL="postgresql://hris:CHANGE_ME@localhost:5432/trilogika_hris?schema=public"

# URL publik aplikasi. Dipakai untuk pemeriksaan Origin (CSRF) dan penentuan cookie `Secure`.
# Production wajib https://
APP_URL="http://localhost:3000"

# Zona waktu bisnis. Semua "hari ini", jam masuk/pulang, dan batas tidak hadir mengacu ke sini (waktu SERVER).
APP_TIMEZONE="Asia/Jakarta"

# Kunci enkripsi AES-256 (32 byte, base64) untuk nomor rekening karyawan. WAJIB; buat dengan:
#   openssl rand -base64 32
# Simpan terpisah dari database & backup. Kehilangan kunci = nomor rekening tidak dapat dibaca lagi.
DATA_ENCRYPTION_KEY=""

# Set "true" HANYA jika aplikasi berada di belakang reverse proxy tepercaya (Nginx/Caddy/Cloudflare)
# sehingga header X-Forwarded-For boleh dipercaya untuk membatasi percobaan masuk per alamat IP.
TRUST_PROXY="false"
# Jumlah proxy tepercaya di depan aplikasi (1 = Nginx/Caddy langsung; 2 = mis. Cloudflare → Nginx).
TRUST_PROXY_HOPS="1"

# Pembatasan percobaan login (per email dan per IP)
LOGIN_MAX_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"
LOGIN_LOCKOUT_MINUTES="15"

# Masa berlaku sesi
SESSION_IDLE_HOURS="8"
SESSION_ABSOLUTE_DAYS="7"

# Batas unggahan (logo, foto, lampiran pengajuan) dalam MB
MAX_UPLOAD_MB="3"

# ── Notifikasi email & "lupa password" (opsional) ─────────────
# Tanpa SMTP_HOST + MAIL_FROM: notifikasi tetap tampil di dalam aplikasi, tetapi tidak dikirim lewat email dan tautan
# "lupa password" mandiri dinonaktifkan (reset oleh Admin/HR tetap tersedia).
SMTP_HOST=""
SMTP_PORT="587"
# "false" = STARTTLS (port 587); "true" = TLS langsung (port 465)
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Contoh: "Trilogika HRIS <hris@trilogikaedutama.id>"
MAIL_FROM=""
# Masa berlaku tautan lupa password (menit)
PASSWORD_RESET_MINUTES="30"

# ── Notifikasi WhatsApp (opsional) ────────────────────────────
# Pilih SATU penyedia: fonnte | cloud_api | webhook. Kosong = WhatsApp nonaktif.
#  fonnte    → WHATSAPP_TOKEN (token perangkat Fonnte)
#  cloud_api → WHATSAPP_TOKEN (access token Meta) + WHATSAPP_PHONE_NUMBER_ID; pesan di luar jendela 24 jam wajib memakai
#              template yang disetujui Meta (WHATSAPP_TEMPLATE_NAME, satu variabel isi {{1}})
#  webhook   → WHATSAPP_API_URL (URL Anda, mis. n8n/gateway lain) menerima POST JSON {to,text}
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
WHATSAPP_API_URL=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="id"

# Pengiriman antrean notifikasi: pekerja di dalam aplikasi (default). Matikan bila memakai pemicu eksternal.
DELIVERY_WORKER="true"
# Retensi foto absensi: pekerja di dalam aplikasi (default). Masa simpan diatur di Pengaturan (bawaan 6 bulan). Matikan bila memakai /api/internal/retention.
RETENTION_WORKER="true"
# (Opsional) rahasia ≥ 16 karakter untuk memicu antrean lewat HTTP:  POST /api/internal/deliveries  (Authorization: Bearer …)
CRON_SECRET=""

# ── Seed produksi (`npm run db:seed`) ─────────────────────────
# Akun Super Admin pertama. Tidak ada password default: seed GAGAL bila kosong / terlalu lemah (<12 karakter).
ADMIN_EMAIL=""
ADMIN_NAME="Super Admin"
ADMIN_PASSWORD=""

# ── Seed demonstrasi (`npm run db:seed:dev`) ──────────────────
# Password untuk akun DEMO (hanya untuk pengujian). Bila kosong, dibuat acak dan dicetak sekali di terminal.
DEV_SEED_PASSWORD=""

# ── Testing ───────────────────────────────────────────────────
# Database TERPISAH untuk integration/E2E test. Tabel di dalamnya akan dikosongkan oleh test!
TEST_DATABASE_URL="postgresql://hris:CHANGE_ME@localhost:5432/trilogika_hris_test?schema=public"
