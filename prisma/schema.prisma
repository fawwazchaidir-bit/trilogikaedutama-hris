// Trilogika Edutama — Internal Human Resources Information System
//
// Prinsip desain skema (lihat docs/ARCHITECTURE.md):
//  * Uang = bilangan bulat Rupiah (BigInt). Tidak ada float untuk nominal.
//  * Status harian absensi (hadir/terlambat/izin/…) TIDAK disimpan: diturunkan dari jadwal + kalender + pengajuan + catatan
//    absensi setiap kali dibaca, sehingga selalu konsisten dengan data sumber dan dapat ditelusuri per hari.
//  * Slip gaji = SNAPSHOT. Saat diterbitkan, isi slip disalin ke `payslips` (JSON) dan dikunci oleh trigger database;
//    koreksi absensi/komponen sesudahnya tidak mengubah slip yang sudah terbit.
//  * Tidak ada cascade delete ke data karyawan/gaji: relasi `Restrict`. Karyawan tidak dihapus, hanya dinonaktifkan.
//  * Trigger di migrasi `*_integrity_guards` menegakkan append-only (audit, koreksi absensi, buku saldo cuti),
//    kunci slip terbit, dan kunci item penggajian di luar status DRAFT (defense in depth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  EMPLOYEE
}

/// Dalam kapasitas apa seseorang memutuskan pengajuan (untuk jejak audit): atasan langsung, pengganti yang ditunjuk, atasan dari atasan
/// (eskalasi saat atasan tidak ada), atau HR/Super Admin (memproses bila diperlukan).
enum ReviewCapacity {
  SUPERVISOR
  DELEGATE
  ESCALATION
  HR
}

/// Checklist siklus karyawan: proses MASUK (onboarding) dan BERHENTI (offboarding). Cukup berupa daftar centang untuk tim kecil.
/// Tingkat jabatan menurut bagan organisasi (SOP). Atribut EKSPLISIT (tidak diturunkan dari pohon atasan); Direktur dikenali dari role Super Admin.
enum JobLevel {
  STAFF
  SUPERVISOR
  MANAGER
}

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

enum ChecklistStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ChecklistItemStatus {
  TODO
  DONE
  NOT_APPLICABLE
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT
  INTERN
}

enum LeaveType {
  IZIN
  SAKIT
  CUTI
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CalendarKind {
  /// Hari libur: tidak ada jadwal kerja.
  HOLIDAY
  /// Hari kerja khusus: tetap dijadwalkan walau jatuh pada hari libur mingguan.
  SPECIAL_WORKDAY
}

enum ScheduleScope {
  ALL
  DIVISION
  EMPLOYEE
}

enum LeaveLedgerKind {
  /// Saldo awal / kuota tahunan.
  GRANT
  /// Penyesuaian manual oleh admin (positif/negatif) dengan catatan.
  ADJUSTMENT
  /// Pemakaian karena pengajuan cuti disetujui (negatif).
  USAGE
  /// Pengembalian karena pengajuan yang sudah disetujui dibatalkan (positif).
  RESTORE
}

enum ComponentKind {
  EARNING
  DEDUCTION
}

enum ComponentCategory {
  BASE_SALARY
  POSITION_ALLOWANCE
  TRANSPORT_ALLOWANCE
  MEAL_ALLOWANCE
  INCENTIVE
  OVERTIME
  OTHER_EARNING
  LATE_DEDUCTION
  ABSENCE_DEDUCTION
  LOAN
  BPJS
  TAX
  OTHER_DEDUCTION
}

enum ComponentCalc {
  /// Nominal tetap per periode.
  FIXED
  /// Nominal × jumlah hari hadir pada periode absensi (mis. uang makan/transport harian).
  PER_PRESENT_DAY
  /// Persen dari gaji pokok (basis point; 100 = 1%). Dipakai untuk BPJS/pajak SESUAI konfigurasi admin.
  PERCENT_OF_BASE
}

enum ComponentRecurrence {
  /// Berlaku untuk setiap periode yang beririsan dengan rentang berlakunya.
  RECURRING
  /// Hanya masuk ke SATU periode: periode penggajian yang memuat tanggal `effectiveFrom`.
  ONE_TIME
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  CANCELLED
}

enum LineSource {
  COMPONENT
  RULE_LATE
  RULE_ABSENCE
  RULE_OVERTIME
  /// BPJS / PPh 21 yang dihitung otomatis dari konfigurasi statutori.
  RULE_STATUTORY
  ADJUSTMENT
}

enum PayslipStatus {
  ACTIVE
  VOIDED
}

enum FileKind {
  LOGO
  EMPLOYEE_PHOTO
  LEAVE_ATTACHMENT
  /// Foto absensi yang sudah dicap (lokasi + waktu server) oleh server.
  ATTENDANCE_PHOTO
  /// Gambar tanda tangan penanda tangan slip gaji (PNG hasil normalisasi server).
  SIGNATURE
  /// PDF dokumen kepegawaian (mis. kontrak kerja bermaterai yang ditandatangani basah, hasil pindai).
  DOCUMENT
  /// Dokumen proyek Training & Operations (privat; hanya diakses lewat API yang memeriksa lingkup proyek).
  TRAINING_DOCUMENT
}

enum LateDeductionMode {
  NONE
  PER_OCCURRENCE
  PER_MINUTE
}

enum AbsenceDeductionMode {
  NONE
  /// Nominal tetap per hari.
  FIXED_PER_DAY
  /// Gaji pokok ÷ pembagi (hari) per hari.
  SALARY_DIVISOR
}

enum OvertimeMode {
  /// Lembur diinput manual sebagai komponen/penyesuaian (default, paling aman).
  MANUAL
  /// Dihitung dari menit setelah jam pulang × tarif per jam (wajib diverifikasi HR).
  AUTO
  /// Hanya lembur yang DISETUJUI lewat pengajuan (dan terbukti ada di absensi) yang dibayar.
  APPROVED
}

enum OvertimeRateMode {
  /// Tarif tetap per jam (Rupiah).
  FIXED_PER_HOUR
  /// Gaji pokok ÷ pembagi (mis. 173) = tarif dasar per jam.
  SALARY_DIVISOR
}

/// Bagian hari untuk izin/sakit/cuti setengah hari. FULL = seluruh hari kerja.
enum LeaveDayPart {
  FULL
  MORNING
  AFTERNOON
}

/// Status PTKP (kode pajak) untuk PPh 21.
enum TaxStatus {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

/// Jenis dokumen kepegawaian. Hanya KONTRAK yang punya tanggal berakhir & pengingat keputusan pimpinan.
enum DocumentKind {
  CONTRACT
  OTHER
}

/// Keputusan pimpinan atas kontrak yang mendekati berakhir.
enum RenewalDecision {
  PENDING
  CONTINUE
  DISCONTINUE
}

enum AssignmentStatus {
  ISSUED
  CANCELLED
}

enum AllowanceMethod {
  CASH
  TRANSFER
}

enum ReceiptStatus {
  ACTIVE
  VOIDED
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
  /// Notifikasi push desktop (Web Push) ke peramban yang berlangganan.
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum PunchKind {
  CHECK_IN
  CHECK_OUT
}

enum AttendancePhotoMode {
  /// Tanpa foto absensi.
  OFF
  /// Foto boleh dilampirkan; tanpa foto tetap diterima.
  OPTIONAL
  /// Check-in dan check-out WAJIB disertai foto bercap.
  REQUIRED
}

enum LocationPolicyMode {
  /// Tidak ada penilaian risiko lokasi.
  OFF
  /// Risiko tinggi tetap diterima tetapi ditandai & masuk antrean tinjauan HR (default).
  FLAG
  /// Risiko tinggi DITOLAK (dan dicatat).
  BLOCK
}

enum LocationDecision {
  ACCEPTED
  FLAGGED
  BLOCKED
}

enum LocationReviewStatus {
  OPEN
  CLEARED
  CONFIRMED
}

// ───────────────────────────── Pengguna & sesi ─────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  /// Akun demonstrasi (hanya untuk pengujian) — antarmuka menampilkan banner peringatan.
  isDemo             Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?

  // Autentikasi dua langkah (TOTP). Rahasia dienkripsi AES-256-GCM (DATA_ENCRYPTION_KEY).
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecretEnc String?
  twoFactorEnabledAt DateTime?
  /// Langkah waktu TOTP terakhir yang diterima — mencegah kode yang sama dipakai dua kali (replay).
  twoFactorLastStep  Int?

  // Preferensi saluran notifikasi di luar aplikasi.
  notifyEmail    Boolean @default(true)
  notifyWhatsapp Boolean @default(false)
  /// Nomor WhatsApp format internasional tanpa "+" (mis. 628123456789).
  whatsappNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  employee        Employee?
  notifications   Notification[]
  auditLogs       AuditLog[]
  recoveryCodes   TwoFactorRecoveryCode[]
  loginChallenges LoginChallenge[]
  passwordResets  PasswordResetToken[]
  deliveries      NotificationDelivery[]
  /// Level akses modul Training & Operations (opsional; tanpa baris = tanpa level modul).
  trainingAccess  TrainingAccess?

  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 dari token acak di cookie. Token mentah tidak pernah disimpan.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RateLimitBucket {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?

  @@map("rate_limit_buckets")
}

/// Kode pemulihan 2FA sekali pakai. Hanya hash-nya yang disimpan.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("two_factor_recovery_codes")
}

/// Tantangan 2FA setelah password benar: sekali pakai, singkat, dibatasi percobaan. Hanya hash token yang disimpan.
model LoginChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("login_challenges")
}

/// Token "lupa password". Sekali pakai, kedaluwarsa singkat, hanya SHA-256-nya yang disimpan.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Data karyawan ─────────────────────────────

/// Template checklist yang dapat diedit HR. Butir bawaan (kode) menjadi data awal saat pertama dipakai; perubahan hanya memengaruhi checklist BARU.
/// Butir tidak dihapus (nonaktifkan). Kunci butir bawaan tetap agar sinyal otomatis tetap menempel.
model EmployeeChecklistTemplateItem {
  id                String        @id @default(uuid()) @db.Uuid
  kind              ChecklistKind
  key               String
  groupLabel        String
  title             String
  hint              String?
  required          Boolean       @default(true)
  sortOrder         Int
  active            Boolean       @default(true)
  /// Penanggung jawab bawaan (akun pengguna) untuk butir ini pada checklist baru.
  defaultAssigneeId String?       @db.Uuid
  /// Tenggat = tanggal checklist dimulai + selisih hari ini (null = tanpa tenggat).
  dueOffsetDays     Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([kind, key])
  @@map("employee_checklist_template_items")
}

/// Kunci dedupe pengingat checklist (idempoten lintas instance/jam).
model EmployeeChecklistReminderLog {
  id        String   @id @default(uuid()) @db.Uuid
  dedupeKey String   @unique
  itemId    String   @db.Uuid
  createdAt DateTime @default(now())

  @@map("employee_checklist_reminder_log")
}

/// Riwayat divisi/jabatan/status/atasan seorang karyawan. APPEND-ONLY (trigger). Kolom pada `employees` = keadaan SAAT INI;
/// baris di sini = jejak tiap perubahan beserta tanggal mulai berlakunya. Karyawan lama tanpa riwayat mendapat baris awal saat pertama kali diubah.
/// Satu proses masuk/berhenti seorang karyawan: daftar centang. Satu yang TERBUKA per (karyawan, jenis) — indeks unik parsial pada migrasi.
/// Tidak dihapus; yang selesai/dibatalkan terkunci (trigger).
model EmployeeChecklist {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @db.Uuid
  kind          ChecklistKind
  status        ChecklistStatus @default(OPEN)
  /// Target selesai (opsional); lewat target = "terlambat".
  targetDate    DateTime?       @db.Date
  note          String?
  startedById   String          @db.Uuid
  startedAt     DateTime        @default(now())
  completedById String?         @db.Uuid
  completedAt   DateTime?
  cancelledById String?         @db.Uuid
  cancelledAt   DateTime?
  cancelReason  String?

  employee Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  items    EmployeeChecklistItem[]

  @@index([employeeId, kind, status])
  @@index([status, targetDate])
  @@map("employee_checklists")
}

model EmployeeChecklistItem {
  id          String              @id @default(uuid()) @db.Uuid
  checklistId String              @db.Uuid
  /// Kunci butir dari template bawaan, atau "custom-…" untuk butir tambahan HR. Unik per checklist.
  key         String
  groupLabel  String
  title       String
  hint        String?
  required    Boolean             @default(true)
  sortOrder   Int
  status      ChecklistItemStatus @default(TODO)
  /// Wajib bila "Tidak berlaku" (alasannya); opsional untuk catatan lain.
  note        String?
  doneById    String?             @db.Uuid
  /// Penanggung jawab butir (akun pengguna). Boleh menandai butirnya sendiri; null = HR.
  assigneeId  String?             @db.Uuid
  /// Tenggat butir (dari template: tanggal checklist dimulai + selisih hari). Dasar pengingat otomatis.
  dueDate     DateTime?           @db.Date
  doneAt      DateTime?
  createdAt   DateTime            @default(now())

  checklist EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Restrict)

  @@unique([checklistId, key])
  @@index([assigneeId, status])
  @@map("employee_checklist_items")
}

model EmployeeOrgHistory {
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @db.Uuid
  effectiveFrom    DateTime         @db.Date
  divisionId       String?          @db.Uuid
  divisionName     String?
  position         String
  employmentStatus EmploymentStatus
  supervisorId     String?          @db.Uuid
  supervisorName   String?
  /// Tingkat jabatan pada baris ini.
  jobLevel         JobLevel         @default(STAFF)
  /// Apa yang berubah pada baris ini: BASELINE, DIVISION, POSITION, STATUS, SUPERVISOR, JOB_LEVEL.
  changes          String[]
  note             String?
  createdById      String           @db.Uuid
  createdAt        DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, effectiveFrom, createdAt])
  @@map("employee_org_history")
}

/// Penunjukan pengganti peninjau: selama rentang tanggal, `delegateId` boleh meninjau pengajuan bawahan langsung `supervisorId`.
/// Tidak dihapus; dibatalkan dengan mengisi cancelledAt (trigger).
model SupervisorDelegation {
  id            String    @id @default(uuid()) @db.Uuid
  supervisorId  String    @db.Uuid
  delegateId    String    @db.Uuid
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  reason        String?
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid

  supervisor Employee @relation("DelegationSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  delegate   Employee @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Restrict)

  @@index([supervisorId, startDate, endDate])
  @@index([delegateId])
  @@map("supervisor_delegations")
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  employees   Employee[]
  assignments ScheduleAssignment[]

  @@map("divisions")
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  /// Nomor induk karyawan (unik, tanpa membedakan huruf besar/kecil).
  employeeNo        String
  fullName          String
  userId            String?          @unique @db.Uuid
  divisionId        String?          @db.Uuid
  position          String
  employmentStatus  EmploymentStatus
  joinDate          DateTime         @db.Date
  /// Tanggal berhenti (diisi saat dinonaktifkan). Hari setelah tanggal ini tidak dihitung dalam rekap & gaji.
  endDate           DateTime?        @db.Date
  phone             String?
  email             String?
  address           String?
  photoFileId       String?          @db.Uuid
  bankName          String?
  /// Nomor rekening dienkripsi AES-256-GCM (kunci DATA_ENCRYPTION_KEY). Tidak pernah ditampilkan lengkap di slip.
  bankAccountEnc    String?
  bankAccountLast4  String?
  bankAccountHolder String?
  isActive          Boolean          @default(true)
  notes             String?

  /// ATASAN LANGSUNG (kepegawaian) — berbeda dari PIC proyek Training. NULL = belum ditetapkan: pengajuan diproses HR/Super Admin seperti semula.
  supervisorId          String?   @db.Uuid
  /// Tanggal mulai berlaku divisi/jabatan/status saat ini. NULL = sejak tanggal mulai bekerja.
  positionEffectiveFrom DateTime? @db.Date
  /// Tingkat jabatan (Staf / Supervisor / Manajer). Berlaku sejak positionEffectiveFrom bersama jabatan; riwayat di employee_org_history.
  jobLevel              JobLevel  @default(STAFF)

  /// Kontak darurat (dilengkapi saat karyawan masuk; hanya terlihat HR dan karyawan itu sendiri).
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  // Atribut statutori (BPJS & PPh 21). Hanya dipakai bila perhitungan otomatis diaktifkan di Pengaturan.
  taxStatus              TaxStatus @default(TK0)
  hasNpwp                Boolean   @default(true)
  bpjsHealthEnrolled     Boolean   @default(true)
  bpjsEmploymentEnrolled Boolean   @default(true)

  // Kebijakan cuti PER KARYAWAN. NULL = ikut kebijakan bawaan lembaga (Pengaturan). Nilai terisi = kebijakan khusus karyawan ini
  // (wajib disertai catatan alasan). Lihat src/lib/leave-policy.ts untuk perhitungan kebijakan efektif.
  /// Kuota cuti tahunan (hari) khusus karyawan ini.
  leaveQuotaDays     Int?
  /// Tanggal mulai berhak cuti. NULL = tanggal mulai bekerja + masa kerja minimum (kebijakan bawaan).
  leaveEligibleFrom  DateTime? @db.Date
  /// Boleh saldo cuti negatif? NULL = ikut kebijakan bawaan.
  leaveAllowNegative Boolean?
  /// Alasan kebijakan khusus (wajib bila salah satu kolom di atas terisi).
  leavePolicyNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User?                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  division            Division?               @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  supervisor          Employee?               @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports             Employee[]              @relation("Supervision")
  orgHistory          EmployeeOrgHistory[]
  checklists          EmployeeChecklist[]
  assetAssignments    AssetAssignment[]
  finalSettlements    FinalSettlement[]
  delegationsGiven    SupervisorDelegation[]  @relation("DelegationSupervisor")
  delegationsReceived SupervisorDelegation[]  @relation("DelegationDelegate")
  photo               StoredFile?             @relation("EmployeePhoto", fields: [photoFileId], references: [id], onDelete: Restrict)
  attendances         Attendance[]
  corrections         AttendanceCorrection[]
  leaves              LeaveRequest[]
  balance             LeaveBalanceEntry[]
  components          SalaryComponent[]
  assignments         ScheduleAssignment[]
  payrollItems        PayrollItem[]
  payslips            Payslip[]
  overtimes           OvertimeRequest[]
  locationChecks      LocationCheck[]
  photos              AttendancePhoto[]
  documents           EmployeeDocument[]
  assignees           AssignmentAssignee[]
  allowances          DailyAllowanceReceipt[]

  // Training & Operations (relasi balik saja; tidak ada kolom baru pada tabel employees).
  trainingMemberships      TrainingProjectMember[]
  trainingTasks            TrainingTask[]
  trainingChecklistItems   TrainingProjectChecklistItem[]
  trainingInstructorEntry  TrainingInstructor?
  trainingScheduleIncharge TrainingSchedule[]
  trainingMilestones       TrainingMilestone[]
  trainingReadinessItems   TrainingReadinessItem[]
  trainingWorkloadTasks    TrainingWorkloadTask[]
  trainingCapacity         TrainingStaffCapacity?

  @@index([divisionId])
  @@index([isActive])
  @@index([fullName])
  @@index([supervisorId])
  @@map("employees")
}

// ───────────────────────────── Jadwal & kalender ─────────────────────────────

model WorkSchedule {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  /// Hari kerja ISO: 1 = Senin … 7 = Minggu.
  workDays             Int[]
  /// "HH:mm" waktu lokal (APP_TIMEZONE).
  startTime            String
  endTime              String
  lateToleranceMinutes Int      @default(0)
  /// Tanpa check-in sampai jam ini → "Tidak hadir" (hanya berlaku untuk hari ini; hari lampau langsung final).
  absentCutoffTime     String
  isDefault            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignments ScheduleAssignment[]

  @@map("work_schedules")
}

model ScheduleAssignment {
  id          String        @id @default(uuid()) @db.Uuid
  scheduleId  String        @db.Uuid
  scope       ScheduleScope
  divisionId  String?       @db.Uuid
  employeeId  String?       @db.Uuid
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  note        String?
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  division Division?    @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  employee Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([scope, startDate])
  @@index([employeeId])
  @@index([divisionId])
  @@map("schedule_assignments")
}

model CalendarDay {
  id          String       @id @default(uuid()) @db.Uuid
  date        DateTime     @unique @db.Date
  kind        CalendarKind
  name        String
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())

  @@map("calendar_days")
}

// ───────────────────────────── Absensi ─────────────────────────────

/// Satu baris per karyawan per hari (unik) → tidak mungkin ada check-in ganda. Baris ada ⇔ sudah check-in.
model Attendance {
  id               String    @id @default(uuid()) @db.Uuid
  employeeId       String    @db.Uuid
  /// Tanggal lokal (APP_TIMEZONE) saat check-in.
  date             DateTime  @db.Date
  checkInAt        DateTime
  checkOutAt       DateTime?
  checkInNote      String?
  checkOutNote     String?
  checkInLat       Float?
  checkInLng       Float?
  checkInAccuracy  Float?
  checkInDistance  Int?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  checkOutDistance Int?
  /// SELF = dicatat karyawan sendiri; ADMIN = dibuat/diubah lewat koreksi admin.
  source           String    @default("SELF")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  locationChecks LocationCheck[]
  photos         AttendancePhoto[]

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendances")
}

/// Riwayat koreksi absensi — append-only. `before`/`after` = null berarti baris belum ada / dihapus.
model AttendanceCorrection {
  id            BigInt   @id @default(autoincrement())
  employeeId    String   @db.Uuid
  date          DateTime @db.Date
  before        Json?
  after         Json?
  reason        String
  correctedById String   @db.Uuid
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, date])
  @@index([createdAt])
  @@map("attendance_corrections")
}

// ───────────────────────────── Pengajuan izin / sakit / cuti ─────────────────────────────

model LeaveRequest {
  id               String          @id @default(uuid()) @db.Uuid
  employeeId       String          @db.Uuid
  type             LeaveType
  startDate        DateTime        @db.Date
  endDate          DateTime        @db.Date
  reason           String
  attachmentFileId String?         @db.Uuid
  status           RequestStatus   @default(PENDING)
  /// FULL = seluruh hari. MORNING/AFTERNOON = setengah hari (hanya untuk pengajuan satu hari).
  dayPart          LeaveDayPart    @default(FULL)
  /// Jumlah hari kerja terjadwal yang tercakup (kelipatan 0,5) — dihitung ulang saat disetujui, lalu dibekukan.
  workingDays      Float?
  reviewedById     String?         @db.Uuid
  reviewedAs       ReviewCapacity?
  reviewedAt       DateTime?
  reviewNote       String?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  employee   Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attachment StoredFile?         @relation("LeaveAttachment", fields: [attachmentFileId], references: [id], onDelete: Restrict)
  ledger     LeaveBalanceEntry[]

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

/// Buku saldo cuti per karyawan per tahun — append-only. Saldo = SUM(days).
model LeaveBalanceEntry {
  id          BigInt          @id @default(autoincrement())
  employeeId  String          @db.Uuid
  year        Int
  kind        LeaveLedgerKind
  /// Hari (kelipatan 0,5 — cuti setengah hari memakai 0,5).
  days        Float
  requestId   String?         @db.Uuid
  note        String?
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())

  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  request  LeaveRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([employeeId, year])
  @@index([requestId])
  @@map("leave_balance_entries")
}

// ───────────────────────────── Komponen gaji & penggajian ─────────────────────────────

model SalaryComponent {
  id            String              @id @default(uuid()) @db.Uuid
  employeeId    String              @db.Uuid
  kind          ComponentKind
  category      ComponentCategory
  name          String
  calc          ComponentCalc       @default(FIXED)
  /// Rupiah. FIXED: nominal per periode. PER_PRESENT_DAY: nominal per hari hadir. PERCENT_OF_BASE: 0.
  amount        BigInt              @default(0)
  /// Hanya untuk PERCENT_OF_BASE (basis point, 100 = 1%).
  percentBp     Int?
  recurrence    ComponentRecurrence @default(RECURRING)
  effectiveFrom DateTime            @db.Date
  effectiveTo   DateTime?           @db.Date
  description   String?
  isActive      Boolean             @default(true)
  /// Pendapatan ini masuk penghasilan bruto untuk PPh 21 (hanya berarti bagi komponen pendapatan).
  taxable       Boolean             @default(true)
  /// Pendapatan ini masuk dasar upah BPJS (gaji pokok + tunjangan tetap). NULL = bawaan menurut kategori
  /// (gaji pokok & tunjangan jabatan masuk); nilai eksplisit menimpa.
  inBpjsBase    Boolean?
  createdById   String              @db.Uuid
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, isActive])
  @@map("salary_components")
}

model PayrollRun {
  id              String        @id @default(uuid()) @db.Uuid
  /// Nomor urut berjalan (dipakai pada nomor slip).
  runNumber       Int           @unique @default(autoincrement())
  label           String
  periodStart     DateTime      @db.Date
  periodEnd       DateTime      @db.Date
  /// Rentang absensi yang menjadi dasar penghitungan (boleh berbeda dari periode gaji, mis. cut-off tgl 25).
  attendanceStart DateTime      @db.Date
  attendanceEnd   DateTime      @db.Date
  status          PayrollStatus @default(DRAFT)
  /// Aturan penggajian yang berlaku saat dihitung (dibekukan agar hasil dapat ditelusuri).
  rulesSnapshot   Json?
  calculatedAt    DateTime?
  note            String?
  createdById     String        @db.Uuid
  submittedById   String?       @db.Uuid
  submittedAt     DateTime?
  approvedById    String?       @db.Uuid
  approvedAt      DateTime?
  approvalNote    String?
  returnedNote    String?
  issuedById      String?       @db.Uuid
  issuedAt        DateTime?
  issueDate       DateTime?     @db.Date
  cancelledById   String?       @db.Uuid
  cancelledAt     DateTime?
  cancelReason    String?
  revisionOfId    String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  revisionOf PayrollRun?   @relation("PayrollRevision", fields: [revisionOfId], references: [id], onDelete: Restrict)
  revisions  PayrollRun[]  @relation("PayrollRevision")
  items      PayrollItem[]
  payslips   Payslip[]

  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("payroll_runs")
}

model PayrollItem {
  id                String           @id @default(uuid()) @db.Uuid
  runId             String           @db.Uuid
  employeeId        String           @db.Uuid
  // Snapshot identitas karyawan saat dihitung.
  employeeNo        String
  employeeName      String
  position          String
  divisionName      String?
  employmentStatus  EmploymentStatus
  bankName          String?
  bankAccountMasked String?
  baseSalary        BigInt           @default(0)
  totalEarnings     BigInt           @default(0)
  totalDeductions   BigInt           @default(0)
  netPay            BigInt           @default(0)
  /// Ringkasan rekap absensi (hari terjadwal, hadir, terlambat, …) yang menjadi dasar penghitungan.
  attendanceSummary Json
  /// Hash rekap harian sumber — dipakai mendeteksi koreksi absensi setelah penghitungan.
  sourceHash        String
  /// Hash komponen gaji yang berlaku pada periode saat dihitung — dipakai mendeteksi perubahan komponen setelah penghitungan.
  /// NULL pada item lama (dihitung sebelum kolom ini ada): tidak dinilai, agar periode lama tidak mendadak ditandai berubah.
  componentsHash    String?
  /// Rincian BPJS (porsi karyawan & perusahaan) dan PPh 21 yang dihitung otomatis (null bila tidak aktif).
  statutory         Json?
  warnings          Json?
  slipNote          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  run      PayrollRun        @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines    PayrollItemLine[]
  payslip  Payslip?

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("payroll_items")
}

model PayrollItemLine {
  id          String            @id @default(uuid()) @db.Uuid
  itemId      String            @db.Uuid
  kind        ComponentKind
  category    ComponentCategory
  name        String
  source      LineSource
  amount      BigInt
  /// Penjelasan perhitungan yang tampil di layar pemeriksaan, mis. "3 hari × Rp 20.000".
  formula     String?
  /// Alasan (wajib untuk penyesuaian manual).
  reason      String?
  /// Komponen gaji sumber (tanpa FK: komponen boleh berubah, baris ini adalah snapshot).
  componentId String?           @db.Uuid
  sortOrder   Int               @default(0)
  createdById String?           @db.Uuid
  createdAt   DateTime          @default(now())

  item PayrollItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId])
  @@map("payroll_item_lines")
}

/// Slip gaji terbit — snapshot tak berubah (dikunci trigger). Hanya status ACTIVE → VOIDED yang diizinkan.
model Payslip {
  id         String        @id @default(uuid()) @db.Uuid
  runId      String        @db.Uuid
  itemId     String        @unique @db.Uuid
  employeeId String        @db.Uuid
  number     String        @unique
  status     PayslipStatus @default(ACTIVE)
  issueDate  DateTime      @db.Date
  issuedAt   DateTime      @default(now())
  netPay     BigInt
  /// Seluruh isi slip (lembaga, karyawan, periode, rincian, total, ringkasan absensi, catatan).
  snapshot   Json
  voidedAt   DateTime?
  voidReason String?
  voidedById String?       @db.Uuid

  run      PayrollRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  item     PayrollItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, issueDate])
  @@index([runId])
  @@map("payslips")
}

// ───────────────────────────── Pengaturan lembaga & kebijakan ─────────────────────────────

/// Singleton (id = 1).
model CompanySettings {
  id         Int     @id @default(1)
  name       String
  legalName  String?
  tagline    String?
  address    String?
  phone      String?
  email      String?
  website    String?
  logoFileId String? @db.Uuid

  // Slip gaji
  slipShowAttendance  Boolean @default(true)
  slipFooterNote      String?
  slipNumberPrefix    String  @default("SG")
  /// Penanda tangan slip (diatur Super Admin): nama, jabatan, kota (opsional), dan gambar tanda tangan (PNG, opsional).
  slipSignerName      String?
  slipSignerTitle     String?
  slipSignerPlace     String?
  slipSignatureFileId String? @db.Uuid

  // Kebijakan absensi (perlu dikonfirmasi oleh Super Admin)
  /// Menit keterlambatan dihitung setelah toleransi (true) atau dari jam masuk (false, default).
  lateMinutesAfterTolerance      Boolean             @default(false)
  locationEnabled                Boolean             @default(false)
  locationName                   String?
  locationLat                    Float?
  locationLng                    Float?
  locationRadiusMeters           Int                 @default(100)
  /// Akurasi GPS terburuk yang diterima (meter). Lebih buruk dari ini → ditolak dengan pesan jelas.
  locationMaxAccuracyMeters      Int                 @default(150)
  /// Berapa hari ke belakang pengajuan izin/sakit boleh diajukan.
  requestBackdateDays            Int                 @default(7)
  attendancePolicyConfirmedAt    DateTime?
  /// Penilaian risiko lokasi palsu (lihat docs/SECURITY.md).
  locationSpoofMode              LocationPolicyMode  @default(FLAG)
  /// Foto absensi bercap lokasi & waktu server (bukti utama untuk dinas luar; tidak bergantung pada Wi-Fi/jaringan kantor).
  attendancePhotoMode            AttendancePhotoMode @default(OFF)
  /// Foto harus disertai koordinat (izin lokasi) agar dapat dicap lokasinya.
  attendancePhotoRequireLocation Boolean             @default(true)
  /// Foto absensi yang lebih tua dari ini dihapus otomatis (jejak teks cap tetap). 0 = simpan selamanya (tidak disarankan).
  attendancePhotoRetentionMonths Int                 @default(6)
  /// Admin & Super Admin wajib mengaktifkan 2FA.
  twoFactorRequiredForAdmins     Boolean             @default(false)

  // Kebijakan cuti BAWAAN (dipakai karyawan yang tidak punya kebijakan khusus; lihat kolom leave* pada Employee)
  annualLeaveQuota          Int     @default(12)
  allowNegativeLeaveBalance Boolean @default(false)
  /// Masa kerja minimum (bulan, dihitung dari tanggal mulai bekerja) sebelum berhak cuti tahunan. 0 = langsung berhak.
  leaveMinTenureMonths      Int     @default(12)

  // Aturan penggajian (TIDAK ada tarif baku — semua nol/nonaktif sampai dikonfigurasi & diverifikasi)
  lateDeductionMode         LateDeductionMode    @default(NONE)
  lateDeductionAmount       BigInt               @default(0)
  absenceDeductionMode      AbsenceDeductionMode @default(NONE)
  absenceDeductionAmount    BigInt               @default(0)
  absenceSalaryDivisor      Int?
  izinDeductsPay            Boolean              @default(true)
  sakitDeductsPay           Boolean              @default(false)
  cutiDeductsPay            Boolean              @default(false)
  overtimeMode              OvertimeMode         @default(MANUAL)
  overtimeRatePerHour       BigInt               @default(0)
  overtimeMinMinutes        Int                  @default(60)
  overtimeMaxMinutesPerDay  Int                  @default(240)
  overtimeRateMode          OvertimeRateMode     @default(FIXED_PER_HOUR)
  overtimeSalaryDivisor     Int                  @default(173)
  /// Pengali jam lembur pertama / berikutnya (basis point; 10000 = 1×, 15000 = 1,5×).
  overtimeFirstHourBp       Int                  @default(10000)
  overtimeNextHoursBp       Int                  @default(10000)
  /// Lembur disetujui hanya dibayar sebesar menit yang terbukti di absensi (check-out setelah jam pulang).
  overtimeRequireAttendance Boolean              @default(true)
  /// Konfigurasi BPJS & PPh 21 otomatis (JSON; null = nonaktif). Divalidasi di server; lihat src/lib/statutory.ts.
  statutoryConfig           Json?
  payrollRulesConfirmedAt   DateTime?
  payrollRulesConfirmedById String?              @db.Uuid

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ───────────────────────────── Berkas, notifikasi, audit ─────────────────────────────

model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  kind         FileKind
  originalName String
  mimeType     String
  size         Int
  sha256       String
  data         Bytes
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  photoOf          Employee[]               @relation("EmployeePhoto")
  attachments      LeaveRequest[]           @relation("LeaveAttachment")
  punchPhoto       AttendancePhoto?
  documents        EmployeeDocument[]
  trainingDocument TrainingProjectDocument?

  @@index([kind])
  @@map("stored_files")
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  href      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Outbox pengiriman email/WhatsApp. Baris dibuat dalam transaksi yang sama dengan peristiwanya (tidak ada notifikasi
/// "hilang" bila server mati), lalu dikirim oleh worker dengan percobaan ulang bertahap.
model NotificationDelivery {
  id             BigInt          @id @default(autoincrement())
  notificationId BigInt?
  userId         String?         @db.Uuid
  channel        DeliveryChannel
  toAddress      String
  subject        String?
  body           String
  status         DeliveryStatus  @default(PENDING)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@map("notification_deliveries")
}

/// Pengajuan lembur: ada alur persetujuan; hanya lembur disetujui yang dapat dibayar (mode "APPROVED").
model OvertimeRequest {
  id              String          @id @default(uuid()) @db.Uuid
  employeeId      String          @db.Uuid
  /// Tanggal kerja (tanggal mulai lembur).
  date            DateTime        @db.Date
  /// Jam mulai lembur "HH:mm" (waktu lokal).
  startTime       String
  /// Durasi yang diajukan (menit); boleh melewati tengah malam.
  minutes         Int
  reason          String
  status          RequestStatus   @default(PENDING)
  /// Menit yang disetujui (≤ diajukan; pimpinan/HR boleh menyetujui lebih sedikit).
  approvedMinutes Int?
  reviewedById    String?         @db.Uuid
  reviewedAs      ReviewCapacity?
  reviewedAt      DateTime?
  reviewNote      String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, date])
  @@index([status, createdAt])
  @@index([date])
  @@map("overtime_requests")
}

/// Catatan penilaian lokasi untuk setiap check-in/out saat absensi berbasis lokasi aktif (termasuk yang ditolak).
/// Foto absensi (check-in/out) yang sudah DICAP server: waktu server + koordinat + nama. Append-only (bukti).
model AttendancePhoto {
  id           String    @id @default(uuid()) @db.Uuid
  attendanceId String?   @db.Uuid
  employeeId   String    @db.Uuid
  kind         PunchKind
  /// NULL setelah foto dihapus oleh retensi (jejak teks cap tetap ada).
  fileId       String?   @unique @db.Uuid
  /// Waktu server yang tercetak pada foto (sama dengan waktu check-in/out yang dicatat).
  capturedAt   DateTime
  lat          Float?
  lng          Float?
  accuracy     Float?
  /// Teks cap yang tercetak pada foto (untuk audit; baris dipisah \n).
  stamp        String
  /// Waktu foto dihapus oleh retensi; NULL = foto masih ada.
  purgedAt     DateTime?
  createdAt    DateTime  @default(now())

  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([attendanceId, kind])
  @@index([employeeId, capturedAt])
  @@index([capturedAt])
  @@map("attendance_photos")
}

model LocationCheck {
  id           BigInt                @id @default(autoincrement())
  employeeId   String                @db.Uuid
  attendanceId String?               @db.Uuid
  kind         PunchKind
  /// Tanggal kerja (lokal).
  date         DateTime              @db.Date
  lat          Float?
  lng          Float?
  accuracy     Float?
  distance     Int?
  decision     LocationDecision
  riskScore    Int                   @default(0)
  flags        String[]              @default([])
  details      Json?
  ip           String?
  deviceHash   String?
  reviewStatus LocationReviewStatus?
  reviewedById String?               @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime              @default(now())

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendance Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([decision, reviewStatus])
  @@index([createdAt])
  @@map("location_checks")
}

// ───────────────────────────── Dokumen kepegawaian (kontrak kerja) ─────────────────────────────

/// Dokumen kepegawaian. KONTRAK = PDF kontrak bermaterai yang ditandatangani basah (hasil pindai) + tanggal mulai/berakhir.
/// Dua bulan menjelang berakhir (H-3 bulan, lalu H-1 bulan & H-14 hari bila belum diputuskan) pimpinan diingatkan untuk memutuskan
/// lanjut/tidak (`renewalDecision`). Dokumen tidak pernah dihapus: salah unggah → diarsipkan dengan alasan; berkas lama tetap tersimpan.
model EmployeeDocument {
  id               String          @id @default(uuid()) @db.Uuid
  employeeId       String          @db.Uuid
  kind             DocumentKind
  title            String
  documentNo       String?
  /// Kontrak: wajib. Dokumen lain: opsional.
  startDate        DateTime?       @db.Date
  /// Kontrak: tanggal berakhir. NULL = tanpa batas waktu (PKWTT) → tidak ada pengingat.
  endDate          DateTime?       @db.Date
  fileId           String          @db.Uuid
  note             String?
  renewalDecision  RenewalDecision @default(PENDING)
  decidedById      String?         @db.Uuid
  decidedAt        DateTime?
  decisionNote     String?
  /// Pengingat yang sudah dikirim ("M3" = H-3 bulan, "M1" = H-1 bulan, "D14" = H-14 hari) — mencegah pengiriman ganda.
  remindersSent    String[]        @default([])
  /// Dokumen ini adalah perpanjangan/pengganti kontrak lain (menghentikan pengingat kontrak yang digantikan).
  renewsDocumentId String?         @db.Uuid
  archivedAt       DateTime?
  archivedById     String?         @db.Uuid
  archiveReason    String?
  uploadedById     String          @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  employee  Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  file      StoredFile         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  renews    EmployeeDocument?  @relation("DocumentRenewal", fields: [renewsDocumentId], references: [id], onDelete: Restrict)
  renewedBy EmployeeDocument[] @relation("DocumentRenewal")

  @@index([employeeId, kind])
  @@index([kind, endDate])
  @@map("employee_documents")
}

// ───────────────────────────── Surat Tugas & Bukti Penerimaan Uang Harian ─────────────────────────────

/// Surat Tugas dari HR / Pimpinan kepada karyawan yang ditunjuk — DASAR pemberian Uang Harian. Isi (lembaga, penanda tangan, penerima
/// tugas) dibekukan di `snapshot` saat terbit. Berdiri sendiri: tidak ada hubungannya dengan penggajian / slip gaji.
model AssignmentLetter {
  id            String           @id @default(uuid()) @db.Uuid
  /// Penomoran per tahun terbit: "001/ST/XI/2026". (seqYear, seqNo) unik.
  seqYear       Int
  seqNo         Int
  number        String           @unique
  status        AssignmentStatus @default(ISSUED)
  purpose       String
  destination   String
  startDate     DateTime         @db.Date
  endDate       DateTime         @db.Date
  details       String?
  issueDate     DateTime         @db.Date
  snapshot      Json
  issuedById    String           @db.Uuid
  issuedAt      DateTime         @default(now())
  cancelledAt   DateTime?
  cancelledById String?          @db.Uuid
  cancelReason  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignees     AssignmentAssignee[]
  receipts      DailyAllowanceReceipt[]
  /// Tautan referensi ke proyek pelatihan (dimiliki modul Training & Operations; surat tugas tetap beku).
  trainingLinks TrainingProjectAssignmentLink[]

  @@unique([seqYear, seqNo])
  @@index([status, startDate])
  @@index([issueDate])
  @@map("assignment_letters")
}

/// Karyawan yang ditugaskan + uang harian yang menjadi haknya untuk perjalanan ini (hari × tarif per hari).
model AssignmentAssignee {
  id         String   @id @default(uuid()) @db.Uuid
  letterId   String   @db.Uuid
  employeeId String   @db.Uuid
  /// Jumlah hari yang dibayar (1 … lama perjalanan, hari kalender).
  days       Int
  /// Rupiah per hari.
  dailyRate  BigInt
  total      BigInt
  createdAt  DateTime @default(now())

  letter   AssignmentLetter        @relation(fields: [letterId], references: [id], onDelete: Restrict)
  employee Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  receipts DailyAllowanceReceipt[]

  @@unique([letterId, employeeId])
  @@index([employeeId])
  @@map("assignment_assignees")
}

/// Bukti Penerimaan Uang Harian — satu dokumen per perjalanan per penerima, berdiri sendiri DI LUAR slip gaji. Snapshot terkunci (trigger);
/// hanya ACTIVE → VOIDED yang diizinkan. Paling banyak satu bukti ACTIVE per penerima (indeks unik parsial pada migrasi).
model DailyAllowanceReceipt {
  id         String          @id @default(uuid()) @db.Uuid
  seqYear    Int
  seqNo      Int
  number     String          @unique
  letterId   String          @db.Uuid
  assigneeId String          @db.Uuid
  employeeId String          @db.Uuid
  status     ReceiptStatus   @default(ACTIVE)
  days       Int
  dailyRate  BigInt
  total      BigInt
  /// Tanggal uang diserahkan (juga tanggal pada blok tanda tangan).
  paidDate   DateTime        @db.Date
  method     AllowanceMethod
  note       String?
  snapshot   Json
  issuedById String          @db.Uuid
  issuedAt   DateTime        @default(now())
  voidedAt   DateTime?
  voidedById String?         @db.Uuid
  voidReason String?

  letter   AssignmentLetter   @relation(fields: [letterId], references: [id], onDelete: Restrict)
  assignee AssignmentAssignee @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  employee Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([seqYear, seqNo])
  @@index([employeeId, paidDate])
  @@index([letterId])
  @@map("daily_allowance_receipts")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now())
  actorId    String?  @db.Uuid
  actorEmail String?
  actorRole  Role?
  /// mis. "employee.update", "attendance.correct", "payroll.approve"
  action     String
  entityType String
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ═════════════════════════════ Training & Operations ═════════════════════════════
//
// Modul operasional pelatihan di dalam Trilogika Internal Portal. Prinsip (lihat docs/TRAINING-OPS.md):
//  * Hanya tabel `training_*` baru. TIDAK ada kolom baru pada tabel HRIS; pengguna & karyawan memakai `users`/`employees` existing.
//  * Hak akses = (role global HRIS tidak diubah) + level modul (`training_access`) + peran proyek (`training_project_members`).
//    Jabatan (`employees.position`) hanya teks informasi dan TIDAK PERNAH dipakai untuk menentukan izin.
//  * Audit memakai `audit_logs` existing (entityType = "TrainingProject", entityId = id proyek untuk semua kejadian dalam proyek).
//  * Relasi `Restrict`: riwayat proyek tidak hilang karena cascade. Proyek tidak dihapus; ia diselesaikan atau dibatalkan.

enum TrainingLevel {
  /// Pemantau: melihat seluruh proyek & laporan, tanpa hak mengubah (mis. Direktur, Manajer Marketing & Relations).
  VIEWER
  /// Admin Program: boleh membuat proyek; mengelola proyek yang ia ikuti sesuai peran proyeknya.
  ADMIN_PROGRAM
  /// Koordinator Program: mengelola seluruh proyek, tim, tugas, program, template, penutupan. Ditunjuk manual oleh Direktur.
  COORDINATOR
}

enum TrainingActivityKind {
  REGULAR
  CERTIFICATION
  IN_HOUSE
  OTHER
}

enum TrainingDeliveryMode {
  ONSITE
  ONLINE
  HYBRID
}

enum TrainingProjectStatus {
  DRAFT
  PREPARATION
  RUNNING
  COMPLETED
  CANCELLED
}

enum TrainingProjectRole {
  PROJECT_MANAGER
  ADMIN_PROGRAM
  PARTICIPANT_OWNER
  MATERIAL_OWNER
  DOCUMENTATION_OWNER
  STAFF
}

enum TrainingTaskStatus {
  TODO
  IN_PROGRESS
  /// Hanya untuk tugas yang `requiresReview`: menunggu diperiksa orang yang berwenang (bukan penanggung jawabnya).
  IN_REVIEW
  DONE
  CANCELLED
}

enum TrainingTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TrainingChecklistPhase {
  PREPARATION
  EXECUTION
  CLOSING
}

enum TrainingScheduleStatus {
  PLANNED
  CONFIRMED
  DONE
  CANCELLED
}

enum TrainingParticipantStatus {
  REGISTERED
  INCOMPLETE_DOCS
  READY
  ATTENDING
  COMPLETED
  CANCELLED
}

enum TrainingInstructorKind {
  INSTRUCTOR
  ASSESSOR
  SPEAKER
  FACILITATOR
}

enum TrainingConfirmation {
  PENDING
  CONFIRMED
  DECLINED
}

enum TrainingDocCategory {
  PROPOSAL
  INVITATION
  MATERIAL
  ATTENDANCE
  PARTICIPANT_DOC
  DOCUMENTATION
  FINAL_REPORT
  OTHER
}

enum TrainingExternalSystem {
  WEBSITE
  HALOAI
  FINANCE
}

/// Level modul per akun. Tanpa baris = tidak ada level (akun tetap dapat melihat proyek tempat ia menjadi anggota).
model TrainingAccess {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @unique @db.Uuid
  level       TrainingLevel
  note        String?
  grantedById String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("training_access")
}

/// Master program: jenis pelatihan yang dapat dilaksanakan berkali-kali (batch).
model TrainingProgram {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  kind        TrainingActivityKind @default(REGULAR)
  description String?
  isActive    Boolean              @default(true)
  createdById String               @db.Uuid
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  projects TrainingProject[]

  @@map("training_programs")
}

/// Satu pelaksanaan/batch pelatihan. Kode "TRN-2026-0001": (seqYear, seqNo) unik, dibuat di bawah advisory lock.
model TrainingProject {
  id                    String                @id @default(uuid()) @db.Uuid
  seqYear               Int
  seqNo                 Int
  code                  String                @unique
  name                  String
  programId             String?               @db.Uuid
  kind                  TrainingActivityKind  @default(REGULAR)
  clientName            String?
  deliveryMode          TrainingDeliveryMode  @default(ONSITE)
  /// Alamat/kota (tatap muka) atau nama platform (daring). Bukan kredensial.
  location              String?
  startDate             DateTime?             @db.Date
  endDate               DateTime?             @db.Date
  status                TrainingProjectStatus @default(DRAFT)
  description           String?
  notes                 String?
  /// Nama template checklist yang dipakai saat dibuat (catatan saja; item checklist disalin menjadi milik proyek).
  checklistTemplateName String?

  // Pemantauan (indikator Ketepatan Waktu, Kesiapan, Beban Tim). Tanggal H = startDate; hari terakhir = endDate.
  /// Reguler (B2C) atau Kerjasama (B2B/B2G): menentukan template milestone & bobot kesiapan.
  track                 TrainingTrack @default(REGULAR)
  /// Reguler: peserta minimum. Kerjasama: jumlah peserta di kontrak. Dipakai sebagai "peserta acuan".
  participantsMin       Int?
  participantsMax       Int?
  /// Memakai skema BNSP? Bila tidak, milestone/item sertifikasi dianggap Tidak berlaku dan komponen Sertifikasi dikeluarkan dari IKP.
  bnsp                  Boolean       @default(false)
  /// Tanggal permintaan klien masuk (T), untuk program kerjasama sebelum tanggal H pasti.
  requestDate           DateTime?     @db.Date
  /// Tutup pendaftaran (bawaan H-3 bila kosong), untuk proyeksi peserta program reguler.
  registrationCloseDate DateTime?     @db.Date
  /// Saat template pemantauan (milestone, item kesiapan, jam kerja) diterapkan; kosong = belum.
  indicatorsAppliedAt   DateTime?

  // Penutupan / pembatalan (dikunci oleh CHECK konsistensi status).
  closedAt              DateTime?
  closedById            String?   @db.Uuid
  /// Catatan hasil pelaksanaan.
  closureSummary        String?
  /// Permasalahan & tindak lanjut.
  closureFollowUp       String?
  /// Terisi bila proyek ditutup padahal ada checklist wajib belum selesai (pengecualian beralasan oleh Koordinator Program).
  closureOverrideReason String?
  cancelledAt           DateTime?
  cancelledById         String?   @db.Uuid
  cancelReason          String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program         TrainingProgram?                @relation(fields: [programId], references: [id], onDelete: Restrict)
  members         TrainingProjectMember[]
  tasks           TrainingTask[]
  checklist       TrainingProjectChecklistItem[]
  schedules       TrainingSchedule[]
  participants    TrainingParticipant[]
  instructors     TrainingProjectInstructor[]
  documents       TrainingProjectDocument[]
  externalRefs    TrainingExternalRef[]
  assignmentLinks TrainingProjectAssignmentLink[]
  milestones      TrainingMilestone[]
  readinessItems  TrainingReadinessItem[]
  workloadTasks   TrainingWorkloadTask[]
  statusSnapshots TrainingStatusSnapshot[]
  recoveryNotes   TrainingRecoveryNote[]

  @@unique([seqYear, seqNo])
  @@index([status, startDate])
  @@index([programId])
  @@index([startDate])
  @@map("training_projects")
}

/// Penugasan karyawan pada proyek. Peran proyek TIDAK mengubah role global HRIS. Mengakhiri penugasan = `endedAt`.
/// Indeks unik parsial (migrasi): satu penugasan AKTIF per (proyek, karyawan) dan satu PROJECT_MANAGER aktif per proyek.
model TrainingProjectMember {
  id          String              @id @default(uuid()) @db.Uuid
  projectId   String              @db.Uuid
  employeeId  String              @db.Uuid
  role        TrainingProjectRole
  note        String?
  startedAt   DateTime            @default(now())
  endedAt     DateTime?
  endedById   String?             @db.Uuid
  createdById String              @db.Uuid
  createdAt   DateTime            @default(now())

  project  TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([employeeId, endedAt])
  @@map("training_project_members")
}

model TrainingTask {
  id             String               @id @default(uuid()) @db.Uuid
  projectId      String               @db.Uuid
  title          String
  description    String?
  assigneeId     String?              @db.Uuid
  /// Tanggal jatuh tempo (tanggal kalender WIB). Terlambat = belum selesai dan jatuh tempo < hari ini (WIB).
  dueDate        DateTime?            @db.Date
  priority       TrainingTaskPriority @default(NORMAL)
  status         TrainingTaskStatus   @default(TODO)
  /// true: penanggung jawab hanya dapat mengirim ke "Menunggu pemeriksaan"; orang berwenang lain yang menyelesaikan.
  requiresReview Boolean              @default(false)
  completedAt    DateTime?
  completedById  String?              @db.Uuid
  createdById    String               @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  project  TrainingProject       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee Employee?             @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  comments TrainingTaskComment[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@map("training_tasks")
}

/// Komentar tugas — append-only (trigger).
model TrainingTaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  task TrainingTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("training_task_comments")
}

model TrainingChecklistTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items TrainingChecklistTemplateItem[]

  @@map("training_checklist_templates")
}

model TrainingChecklistTemplateItem {
  id         String                 @id @default(uuid()) @db.Uuid
  templateId String                 @db.Uuid
  phase      TrainingChecklistPhase
  title      String
  isRequired Boolean                @default(false)
  sortOrder  Int                    @default(0)

  template TrainingChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId, phase, sortOrder])
  @@map("training_checklist_template_items")
}

/// Item checklist MILIK PROYEK (disalin dari template saat diterapkan; perubahan template tidak mengubahnya).
/// Checklist dan tugas sengaja terpisah: progres kesiapan = item checklist saja, sehingga satu pekerjaan tidak terhitung dua kali.
model TrainingProjectChecklistItem {
  id                 String                 @id @default(uuid()) @db.Uuid
  projectId          String                 @db.Uuid
  phase              TrainingChecklistPhase
  title              String
  isRequired         Boolean                @default(false)
  sortOrder          Int                    @default(0)
  assigneeId         String?                @db.Uuid
  isDone             Boolean                @default(false)
  doneAt             DateTime?
  doneById           String?                @db.Uuid
  note               String?
  sourceTemplateName String?
  createdById        String                 @db.Uuid
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  project  TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee Employee?       @relation(fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([projectId, phase, sortOrder])
  @@index([assigneeId, isDone])
  @@map("training_project_checklist_items")
}

/// Direktori instruktur/asesor/narasumber/fasilitator. Karyawan internal ditautkan lewat `employeeId` (tanpa akun baru);
/// pihak eksternal cukup kontak operasional.
model TrainingInstructor {
  id           String                 @id @default(uuid()) @db.Uuid
  name         String
  kind         TrainingInstructorKind @default(INSTRUCTOR)
  employeeId   String?                @unique @db.Uuid
  organization String?
  expertise    String?
  phone        String?
  email        String?
  isActive     Boolean                @default(true)
  createdById  String                 @db.Uuid
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  employee    Employee?                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignments TrainingProjectInstructor[]

  @@index([name])
  @@map("training_instructors")
}

model TrainingProjectInstructor {
  id           String                 @id @default(uuid()) @db.Uuid
  projectId    String                 @db.Uuid
  instructorId String                 @db.Uuid
  kind         TrainingInstructorKind
  confirmation TrainingConfirmation   @default(PENDING)
  note         String?
  createdById  String                 @db.Uuid
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  project    TrainingProject    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  instructor TrainingInstructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  schedules  TrainingSchedule[]

  @@unique([projectId, instructorId])
  @@index([instructorId])
  @@map("training_project_instructors")
}

/// Jadwal kegiatan. Waktu disimpan sebagai instan (UTC) dan ditampilkan dalam APP_TIMEZONE (Asia/Jakarta).
model TrainingSchedule {
  id                  String                 @id @default(uuid()) @db.Uuid
  projectId           String                 @db.Uuid
  title               String
  startAt             DateTime
  endAt               DateTime
  location            String?
  /// Label ruangan (dibandingkan tanpa membedakan huruf besar/kecil untuk peringatan bentrok).
  room                String?
  inchargeId          String?                @db.Uuid
  projectInstructorId String?                @db.Uuid
  status              TrainingScheduleStatus @default(PLANNED)
  note                String?
  createdById         String                 @db.Uuid
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  project           TrainingProject            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  incharge          Employee?                  @relation(fields: [inchargeId], references: [id], onDelete: Restrict)
  projectInstructor TrainingProjectInstructor? @relation(fields: [projectInstructorId], references: [id], onDelete: Restrict)

  @@index([projectId, startAt])
  @@index([startAt])
  @@map("training_schedules")
}

/// Peserta (data operasional lokal, input manual). Status peserta ≠ status pembayaran ≠ status kompetensi: sengaja
/// TIDAK ada kolom pembayaran/kompetensi di sini dan tidak ada perubahan status otomatis dari sistem lain.
model TrainingParticipant {
  id           String                    @id @default(uuid()) @db.Uuid
  projectId    String                    @db.Uuid
  fullName     String
  organization String?
  phone        String?
  email        String?
  status       TrainingParticipantStatus @default(REGISTERED)
  note         String?
  /// "MANUAL" = dimasukkan manual (referensi lokal). Nilai lain dicadangkan untuk integrasi masa depan yang sudah diuji.
  source       String                    @default("MANUAL")
  /// Terkonfirmasi (reguler: pembayaran sudah diverifikasi lewat Form Konfirmasi Pembayaran; kerjasama: nama diterima dari klien).
  /// Diisi MANUAL oleh pengelola peserta; bukan status pembayaran dari sistem lain dan tidak diubah otomatis.
  confirmedAt  DateTime?                 @db.Date
  createdById  String                    @db.Uuid
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  project TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([fullName])
  @@map("training_participants")
}

/// Dokumen proyek. Isi berkas di `stored_files` (privat; tidak ada URL publik). "Hapus" = sembunyikan (`deletedAt`) dan
/// mencabut akses; baris & berkas tetap tersimpan sebagai jejak.
model TrainingProjectDocument {
  id           String              @id @default(uuid()) @db.Uuid
  projectId    String              @db.Uuid
  category     TrainingDocCategory
  title        String
  note         String?
  fileId       String              @unique @db.Uuid
  uploadedById String              @db.Uuid
  createdAt    DateTime            @default(now())
  deletedAt    DateTime?
  deletedById  String?             @db.Uuid

  project TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  file    StoredFile      @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([projectId, deletedAt])
  @@map("training_project_documents")
}

/// Referensi MANUAL ke sistem lain (website, HaloAI, sistem keuangan). BUKAN integrasi: tidak ada sinkronisasi.
/// Unik per (proyek, sistem, id eksternal) agar integrasi masa depan idempoten.
model TrainingExternalRef {
  id          String                 @id @default(uuid()) @db.Uuid
  projectId   String                 @db.Uuid
  system      TrainingExternalSystem
  externalId  String
  label       String?
  createdById String                 @db.Uuid
  createdAt   DateTime               @default(now())

  project TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, system, externalId])
  @@map("training_external_refs")
}

/// Tautan referensi proyek ↔ surat tugas. Dimiliki modul ini agar tabel surat tugas (beku oleh trigger) tidak disentuh.
/// Hanya referensi: status/persetujuan surat tugas & uang harian tetap sepenuhnya di HRIS.
model TrainingProjectAssignmentLink {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  letterId   String   @db.Uuid
  linkedById String   @db.Uuid
  createdAt  DateTime @default(now())

  project TrainingProject  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  letter  AssignmentLetter @relation(fields: [letterId], references: [id], onDelete: Restrict)

  @@unique([projectId, letterId])
  @@index([letterId])
  @@map("training_project_assignment_links")
}

// ───────────── Indikator pemantauan (Ketepatan Waktu · Kesiapan · Beban Tim) ─────────────
// Rumus: "Indikator Pemantauan Program Pelatihan" v1.0 (4 Nov 2026). Parameter (ambang, bobot, template, jam standar) TIDAK ditulis di
// dalam rumus: disimpan sebagai konfigurasi berversi (`training_indicator_config`) dan dapat diubah Direktur tanpa programmer.

enum TrainingTrack {
  REGULAR
  PARTNER
}

enum TrainingAnchor {
  /// Hari pertama pelaksanaan (H).
  H
  /// Hari terakhir pelaksanaan (H+n dihitung dari sini).
  H_END
  /// Tanggal permintaan klien masuk (T).
  T
  /// Relatif terhadap tenggat milestone lain (refCode).
  MILESTONE
  /// Tanggal diisi manual (mis. termin kontrak, jatuh tempo invoice).
  MANUAL
}

enum TrainingReadinessComponent {
  INSTRUCTOR
  MATERIAL
  LOGISTICS
  ADMIN
  CERTIFICATION
}

enum TrainingReadinessStatus {
  OPEN
  DONE
  NOT_APPLICABLE
}

enum TrainingWorkloadStatus {
  OPEN
  DONE
  CANCELLED
}

/// Milestone program (salinan template saat diterapkan). Tenggat TIDAK disimpan: dihitung dari tanggal H/T + offset, sehingga ikut bergeser
/// bila tanggal H berubah. Milestone tidak dianggap selesai tanpa bukti (bila diwajibkan konfigurasi).
model TrainingMilestone {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @db.Uuid
  code          String
  name          String
  anchor        TrainingAnchor
  offsetDays    Int            @default(0)
  /// true = hari kerja (mis. T + 2 hari kerja); false = hari kalender.
  offsetWork    Boolean        @default(false)
  refCode       String?
  manualDate    DateTime?      @db.Date
  weight        Int
  critical      Boolean        @default(false)
  /// Hanya berlaku bila program memakai skema BNSP; bila tidak, dianggap Tidak berlaku (dihitung saat dibaca).
  bnspOnly      Boolean        @default(false)
  assigneeId    String?        @db.Uuid
  roleKey       String?
  doneAt        DateTime?      @db.Date
  doneById      String?        @db.Uuid
  evidence      String?
  notApplicable Boolean        @default(false)
  reference     String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project  TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee Employee?       @relation(fields: [assigneeId], references: [id], onDelete: Restrict)

  @@unique([projectId, code])
  @@index([projectId, sortOrder])
  @@index([assigneeId])
  @@map("training_milestones")
}

/// Item kesiapan (komponen IKP). Berbeda dari checklist umum/penutupan: terbobot per komponen, punya tenggat dan penanda kritikal.
model TrainingReadinessItem {
  id          String                     @id @default(uuid()) @db.Uuid
  projectId   String                     @db.Uuid
  component   TrainingReadinessComponent
  name        String
  critical    Boolean                    @default(false)
  anchor      TrainingAnchor
  offsetDays  Int                        @default(0)
  offsetWork  Boolean                    @default(false)
  refCode     String?
  manualDate  DateTime?                  @db.Date
  bnspOnly    Boolean                    @default(false)
  status      TrainingReadinessStatus    @default(OPEN)
  assigneeId  String?                    @db.Uuid
  roleKey     String?
  updatedById String?                    @db.Uuid
  sortOrder   Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  project  TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee Employee?       @relation(fields: [assigneeId], references: [id], onDelete: Restrict)

  @@index([projectId, component])
  @@index([assigneeId])
  @@map("training_readiness_items")
}

/// Tugas beban kerja (jam) per staf untuk satu program. Dibuat dari Tabel Jam Standar (source = TEMPLATE) atau ditambah atasan (MANUAL).
model TrainingWorkloadTask {
  id          String                 @id @default(uuid()) @db.Uuid
  projectId   String                 @db.Uuid
  employeeId  String                 @db.Uuid
  name        String
  hours       Float
  startDate   DateTime               @db.Date
  endDate     DateTime               @db.Date
  status      TrainingWorkloadStatus @default(OPEN)
  /// "TEMPLATE" (dibuat otomatis; dibuat ulang bila tanggal/peserta program berubah) atau "MANUAL" (tidak pernah ditimpa otomatis).
  source      String                 @default("TEMPLATE")
  roleKey     String?
  createdById String?                @db.Uuid
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project  TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([projectId, status])
  @@index([employeeId, startDate, endDate])
  @@map("training_workload_tasks")
}

/// Kapasitas per staf. Tanpa baris = memakai bawaan konfigurasi (jam efektif 6/hari, Senin–Jumat). Cuti diambil dari cuti disetujui di HRIS (opsional).
model TrainingStaffCapacity {
  employeeId  String   @id @db.Uuid
  hoursPerDay Float?
  workDays    Int[]    @default([1, 2, 3, 4, 5])
  note        String?
  updatedById String   @db.Uuid
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("training_staff_capacity")
}

/// Konfigurasi indikator AKTIF (singleton id = 1). Hanya Super Admin (Direktur) yang mengubahnya; setiap perubahan = versi baru.
model TrainingIndicatorConfig {
  id          Int      @id @default(1)
  version     Int
  config      Json
  note        String?
  updatedById String   @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("training_indicator_config")
}

/// Riwayat seluruh versi konfigurasi — append-only (trigger): dapat ditelusuri rumus/ambang mana yang berlaku kapan.
model TrainingIndicatorConfigVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     Int      @unique
  config      Json
  note        String?
  changedById String   @db.Uuid
  createdAt   DateTime @default(now())

  @@map("training_indicator_config_versions")
}

// ───────────── Otomasi pemantauan: snapshot harian, pengingat, catatan pemulihan ─────────────

enum TrainingRecoveryKind {
  YELLOW_STREAK
  RED
  OVERDUE
  OVERLOAD
  OTHER
}

/// Status program per hari (satu baris per program per tanggal WIB; pekerja harian menimpa baris hari yang sama). Dasar aturan "Kuning 2 hari berturut-turut".
model TrainingStatusSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @db.Uuid
  date       DateTime @db.Date
  /// GREEN | YELLOW | RED (dijaga CHECK).
  overall    String
  timeliness String?
  readiness  String?
  load       String?
  triggers   String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, date])
  @@index([date])
  @@map("training_status_snapshots")
}

/// Catatan pengiriman pengingat/eskalasi agar tidak terkirim dua kali walau pekerja berjalan berulang (kunci unik per penerima + peristiwa).
model TrainingReminderLog {
  id        BigInt   @id @default(autoincrement())
  dedupeKey String   @unique
  kind      String
  projectId String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@map("training_reminder_log")
}

/// Rencana/catatan pemulihan program (Kuning 2 hari berturut-turut, Merah, milestone terlambat, beban berlebih). Append-only.
model TrainingRecoveryNote {
  id          String               @id @default(uuid()) @db.Uuid
  projectId   String               @db.Uuid
  kind        TrainingRecoveryKind
  body        String
  /// Tanggal selesai baru yang dijanjikan (informasi; tenggat milestone tetap dihitung dari rumus).
  newDate     DateTime?            @db.Date
  createdById String               @db.Uuid
  createdAt   DateTime             @default(now())

  project TrainingProject @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@map("training_recovery_notes")
}

// ───────────── Portal: pesan banner beranda (broadcast Direktur) ─────────────

/// Pesan pada banner beranda yang dilihat seluruh karyawan. Hanya Super Admin (Direktur) yang menulis. APPEND-ONLY: pesan terbaru yang aktif dan belum
/// kedaluwarsa yang tampil; `active = false` = kembali ke banner bawaan. Seluruh riwayat tersimpan.
model PortalAnnouncement {
  id            String    @id @default(uuid()) @db.Uuid
  /// Urutan monoton: "pesan terbaru" = seq terbesar (tidak bergantung pada cap waktu milidetik).
  seq           BigInt    @unique @default(autoincrement())
  title         String
  body          String?
  active        Boolean   @default(true)
  /// Tanggal terakhir pesan tampil (WIB, inklusif). Kosong = sampai diganti.
  expiresAt     DateTime? @db.Date
  /// Jumlah akun yang juga diberi notifikasi saat pesan dikirim (0 = hanya banner).
  notifiedCount Int       @default(0)
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@map("portal_announcements")
}

// ───────────── Notifikasi push desktop (Web Push) ─────────────

/// Satu baris = satu peramban/perangkat desktop yang SENGAJA diaktifkan pengguna (izin peramban + klik "Aktifkan"). Alamat `endpoint` adalah
/// URL rahasia milik push service peramban (hanya host resmi yang diterima — lihat src/lib/webpush.ts). Dihapus saat keluar/dimatikan/kedaluwarsa.
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  /// Label perangkat untuk daftar "perangkat saya" (mis. "Chrome · Windows"); bukan pengenal unik.
  label         String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─────────────────────────── Aset perusahaan (serah-terima & pengembalian) ───────────────────────────

enum AssetCategory {
  LAPTOP
  PHONE
  ACCESS_CARD
  KEY
  UNIFORM
  VEHICLE
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  LOST
  RETIRED
}

enum AssetCondition {
  GOOD
  DAMAGED
  LOST
}

/// Aset perusahaan yang dipinjamkan ke karyawan. Tidak dihapus (trigger); dinonaktifkan lewat status RETIRED (terminal).
/// Status ASSIGNED ⇔ ada satu penugasan aktif (dijaga service + indeks unik parsial pada migrasi).
model Asset {
  id           String        @id @default(uuid()) @db.Uuid
  /// Kode urut "AST-0001" (dari sequence database; tidak berubah).
  code         String        @unique
  name         String
  category     AssetCategory
  serialNo     String?
  note         String?
  status       AssetStatus   @default(AVAILABLE)
  createdById  String        @db.Uuid
  retiredAt    DateTime?
  retiredById  String?       @db.Uuid
  retireReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignments AssetAssignment[]

  @@index([status, category])
  @@map("assets")
}

/// Satu serah-terima aset ke karyawan. Terbuka selama returnedOn NULL (satu per aset — indeks unik parsial); setelah dikembalikan terkunci.
model AssetAssignment {
  id              String          @id @default(uuid()) @db.Uuid
  assetId         String          @db.Uuid
  employeeId      String          @db.Uuid
  assignedOn      DateTime        @db.Date
  assignedById    String          @db.Uuid
  note            String?
  returnedOn      DateTime?       @db.Date
  returnedById    String?         @db.Uuid
  returnCondition AssetCondition?
  returnNote      String?
  createdAt       DateTime        @default(now())

  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, returnedOn])
  @@index([assetId, assignedOn])
  @@map("asset_assignments")
}

// ─────────────────────────── Penyelesaian akhir (final settlement) ───────────────────────────

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum SettlementBasis {
  WORKING_DAYS
  CALENDAR_DAYS
}

enum SettlementLineCategory {
  PRORATED_SALARY
  LEAVE_PAYOUT
  UNPAID_ALLOWANCE
  SEVERANCE
  SERVICE_AWARD
  ENTITLEMENT
  THR
  OTHER_EARNING
  TAX
  BPJS
  LOAN
  ASSET
  OTHER_DEDUCTION
}

enum SettlementLineSource {
  SYSTEM
  MANUAL
}

/// Penyelesaian hak & kewajiban saat karyawan berhenti. Sistem hanya MENGUSULKAN yang dapat dihitung dari data (gaji prorata, uang harian belum dibayar,
/// uang cuti bila pembagi diisi); pesangon, UPMK, UPH, THR, dan pajak TIDAK dihitung sistem — HR mengisinya sebagai baris manual.
/// Satu penyelesaian non-batal per karyawan (indeks unik parsial pada migrasi). Baris hanya berubah saat DRAFT; setelah disetujui terkunci (trigger).
model FinalSettlement {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @db.Uuid
  status          SettlementStatus @default(DRAFT)
  lastWorkDate    DateTime         @db.Date
  basis           SettlementBasis  @default(WORKING_DAYS)
  /// Pembagi uang cuti (hari kerja per bulan) yang ditetapkan HR; NULL = tidak ada usulan uang cuti.
  leaveDivisor    Int?
  note            String?
  totalEarnings   BigInt           @default(0)
  totalDeductions BigInt           @default(0)
  netPayable      BigInt           @default(0)
  preparedById    String           @db.Uuid
  submittedById   String?          @db.Uuid
  submittedAt     DateTime?
  returnedNote    String?
  approvedById    String?          @db.Uuid
  approvedAt      DateTime?
  approvalNote    String?
  paidById        String?          @db.Uuid
  paidAt          DateTime?
  paidOn          DateTime?        @db.Date
  payReference    String?
  cancelledById   String?          @db.Uuid
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines    FinalSettlementLine[]

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@map("final_settlements")
}

model FinalSettlementLine {
  id           String                 @id @default(uuid()) @db.Uuid
  settlementId String                 @db.Uuid
  kind         ComponentKind
  category     SettlementLineCategory
  name         String
  /// Rupiah, selalu positif; jenis (pendapatan/potongan) menentukan tandanya pada total.
  amount       BigInt
  /// Rumus/dasar perhitungan yang ditulis agar dapat diperiksa penyetuju.
  formula      String?
  source       SettlementLineSource   @default(MANUAL)
  note         String?
  sortOrder    Int
  createdAt    DateTime               @default(now())

  settlement FinalSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([settlementId, sortOrder])
  @@map("final_settlement_lines")
}
